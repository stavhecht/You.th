# --- database ---
# Port 5433 (not 5432) — see the comment in docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://evidwell:evidwell@localhost:5433/evidwell

# tests/test_db_invariants.py reads this, NOT DATABASE_URL, and its built-in
# default is port 5432 — which nothing listens on. Unset, that suite skips
# silently and `pytest` reports green without having checked invariants #1 or
# #4 at all. Set it.
TEST_DATABASE_URL=postgresql+asyncpg://evidwell:evidwell@localhost:5433/evidwell

# --- auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-characters-long-please

# --- Claude ---
ANTHROPIC_API_KEY=

# A model per job — see DESIGN.md §3.6. Defaults shown; uncomment to override.
# Raise SYNTHESIS_MODEL to claude-opus-5 if drafts start failing validation.
# EXTRACTION_MODEL=claude-haiku-4-5
# SYNTHESIS_MODEL=claude-sonnet-5
# APPRAISE (which way each source points) uses SYNTHESIS_MODEL unless set.
# APPRAISAL_MODEL=

# --- embeddings ---
# Changing provider or dimension after the cache has rows requires a re-embed
# AND a migration. See DESIGN.md §3.5.
EMBEDDING_PROVIDER=voyage
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
OPENAI_API_KEY=

# --- scholarly providers ---
# Which APIs retrieval fans out across. Comma-separated; the code default is
# `pubmed` alone. Every enabled provider is queried for every claim and the
# results are merged per paper (retrieve.py::_dedup), so adding one raises
# recall and metadata quality rather than just adding duplicates.
#   pubmed           — best study-type metadata; the grade bonus depends on it
#   openalex         — broad coverage, weak study typing (single `type` string)
#   europe_pmc       — no key required, so it is free recall
#   semantic_scholar — returns nothing at all without an API key, by design
ENABLED_PROVIDERS=pubmed,openalex

# Optional but strongly recommended: raises PubMed from 3 to 10 req/s.
PUBMED_API_KEY=
# Not optional if semantic_scholar is enabled — the provider skips itself
# entirely when this is blank rather than burning retries on 429s.
SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex polite pool — just an email address, materially better latency.
OPENALEX_MAILTO=
# Free from openalex.org. Without it OpenAlex shares ~100 searches a day per IP,
# then refuses every call (429) until midnight UTC.
OPENALEX_API_KEY=

# --- imageGEN ---
IMAGE_GEN_KEY=
# none turns image generation off without removing the key.
# IMAGE_PROVIDER=none

# --- research agent: trend search, then the evidence check ---
# Trend sources a run may use (a trigger can narrow, never widen). Default:
# google_trends,rss,gdelt,news,web,youtube. google_news is off by
# default: its feed says "for personal, non-commercial use" — add it only if
# that fits your use. A keyed source without its key is skipped, never scraped.
# RESEARCH_ENABLED_SOURCES=google_trends,rss,gdelt,news,web,youtube
# newsapi.org key; unset uses keyless DuckDuckGo news.
NEWS_API_KEY=
# false uses DuckDuckGo news even with a key set.
# NEWS_API_ENABLED=false
# Brave Search API token: web search through a documented API instead of
# keyless DuckDuckGo (ddgs). Sent in a header.
BRAVE_SEARCH_API_KEY=
# YouTube Data API v3 key (Google Cloud). ~1,010 of 10,000 daily units a run.
YOUTUBE_API_KEY=
# Shared by the backend and n8n (docker compose --profile automation), 32+
# characters: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RESEARCH_TRIGGER_TOKEN=
# n8n's weekly schedule and timezone.
# RESEARCH_WEEKLY_CRON=0 8 * * 0
# GENERIC_TIMEZONE=UTC
# n8n: parameters for the weekly run, as JSON (same fields as the API), and
# where to POST a summary when it finishes (a Slack-style webhook works).
# RESEARCH_WEEKLY_PARAMS={"categories": ["fitness", "nutrition", "sleep_recovery"]}
# RESEARCH_NOTIFY_URL=
