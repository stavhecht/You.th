# Copy to backend/.env. Defaults below are the local, free setup: every model
# call — both generative calls and embeddings — runs against a local Ollama, so
# no key is needed to run the pipeline end to end.
#
# Switching to hosted providers for real deployment is the two LLM_PROVIDER /
# EMBEDDING_PROVIDER lines plus the keys; no code changes. Note that changing
# the embedding provider on a populated `sources` table requires a re-embed —
# vectors from different models are not comparable.

DEBUG=false

DATABASE_URL=postgresql+asyncpg://evidwell:evidwell@localhost:5433/evidwell
JWT_SECRET=dev-only-insecure-secret-change-me-32-chars
CORS_ORIGINS=http://localhost:5173

# --- generative provider: 'ollama' (local, free) | 'anthropic' (hosted) ---
LLM_PROVIDER=ollama

# Pull these before the first run:
#   ollama pull llama3.1:8b
#   ollama pull mxbai-embed-large
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EXTRACTION_MODEL=llama3.1:8b
OLLAMA_SYNTHESIS_MODEL=llama3.1:8b
# APPRAISE labels which way each ranked source points (one call per claim).
# Defaults to llama3.1:8b (the extraction model), chosen on measured accuracy;
# empty means the synthesis model. APPRAISAL_ENABLED=false skips the stage.
# OLLAMA_APPRAISAL_MODEL=llama3.1:8b
# APPRAISAL_ENABLED=true
# one_call (default, measured best on llama3.1:8b) | two_call (relevance first)
# APPRAISAL_MODE=one_call
OLLAMA_TIMEOUT_SECONDS=600

# Used when LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# EXTRACTION_MODEL=claude-sonnet-5
# SYNTHESIS_MODEL=claude-sonnet-5
# APPRAISAL_MODEL=        # empty means SYNTHESIS_MODEL; a new one needs a price entry

# --- embeddings: 'ollama' | 'voyage' | 'openai' ---
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
# 1024 for both mxbai-embed-large and voyage-4, so local -> hosted is a
# re-embed but not a migration. Must match the migration's vector(N).
EMBEDDING_DIM=1024

# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# --- article images ---
# The bytes live in the database, in `media_objects`, keyed by their SHA-256 —
# so there is nothing here to point at a directory and nothing to back up
# separately. Served (unauthenticated, like any article asset) at
# /api/media/...; uploading needs a reviewer token.
# Per-file ceiling on uploads, in bytes.
MEDIA_MAX_BYTES=8388608

# --- article imagery (generated) ---
# Every draft gets two pictures from one prompt: a landscape lead image placed
# in the article body, and a portrait cover for the feed tile.
#
# IMAGE_GEN_KEY is a Hugging Face token, and it must be a fine-grained token
# with "Make calls to Inference Providers" — a plain read token authenticates
# and then 403s on the first render. Get one at
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write
#
# Leaving it empty is a supported configuration, not a broken one: drafts are
# written without pictures, the feed draws typographic tiles, and the run
# records `cause: "not_configured"` on its illustrate stage. Image generation
# never fails a run — an article is publishable without a decoration.
#
# Set IMAGE_PROVIDER=none to skip it entirely even when a key is present.
IMAGE_PROVIDER=huggingface
# IMAGE_GEN_KEY=
# IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# 'auto' picks the fastest available provider and fails over. Name one
# (nscale, fal-ai, replicate, together) to pin latency and billing.
# IMAGE_INFERENCE_PROVIDER=auto
# IMAGE_TIMEOUT_SECONDS=120

# FLUX.1-schnell is distilled for 1-4 steps at guidance 0.0 — the model card's
# numbers, not tuning knobs. More steps cost credits and buy nothing here.
# IMAGE_STEPS=4
# IMAGE_GUIDANCE_SCALE=0.0

# All four must be positive multiples of 16 or startup refuses: diffusion
# providers otherwise round to their own grid without saying so, and a tile
# cropped to the wrong shape has nothing anywhere explaining why.
# IMAGE_LEAD_WIDTH=1216
# IMAGE_LEAD_HEIGHT=832
# IMAGE_COVER_WIDTH=864
# IMAGE_COVER_HEIGHT=1152
# crop: render the lead once and cut the feed tile's cover out of it (one
# billed render per article). render: draw the cover as a second generation.
# IMAGE_COVER_MODE=crop

# Image spend is deliberately OUTSIDE the token ledger, like embeddings — an
# image is billed per render, and pipeline_stage_runs prices four token
# columns. A run's estimatedCostUsd excludes it. That is "not measured", not
# "free".

# --- scholarly providers (all optional; PubMed works unauthenticated) ---
# Setting PUBMED_API_KEY raises its request ceiling from 3/s to 10/s, and the
# throttle in retrieval/factory.py picks the higher rate automatically.
# SEMANTIC_SCHOLAR_API_KEY is not optional if you enable that provider — it is
# skipped at startup without one, because unauthenticated search 429s under any
# real fan-out.
# PUBMED_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# OPENALEX_MAILTO=
# OPENALEX_API_KEY=   # free; keyless OpenAlex runs out after ~100 searches/day per IP
ENABLED_PROVIDERS=pubmed

# Retries for a provider answering 429. Per-provider request *rates* are
# constants in retrieval/factory.py, not settings — they are facts about each
# API rather than knobs.
# PROVIDER_MAX_RETRIES=2
# PROVIDER_MAX_RETRY_WAIT_SECONDS=10

# --- pipeline worker ---
# How many times a run may be started before a *retryable* failure (a throttled
# provider, a claim that went unsearched) is treated as permanent. Other
# failures are never retried at any budget. Backoff between attempts is
# orchestrator.RETRY_DELAYS. A run whose worker was killed spends the same
# budget: the attempt is counted when the run is claimed, not when it finishes.
# WORKER_POLL_INTERVAL_SECONDS=5
# PIPELINE_MAX_ATTEMPTS=3

# Crash recovery. The worker pings pipeline_runs.heartbeat_at every
# WORKER_HEARTBEAT_SECONDS while a run is in flight; a run silent for longer
# than WORKER_STALE_AFTER_SECONDS is treated as abandoned and requeued (or
# failed, if its attempts are spent) by a sweep that runs every
# WORKER_SWEEP_INTERVAL_SECONDS between polls.
#
# STALE_AFTER must be at least 3x HEARTBEAT — startup refuses otherwise. Set
# closer together, one slow UPDATE marks a *live* run abandoned, and the run is
# then executed a second time concurrently, producing a duplicate article.
# WORKER_HEARTBEAT_SECONDS=15
# WORKER_STALE_AFTER_SECONDS=120
# WORKER_SWEEP_INTERVAL_SECONDS=60

# --- research agent (app/research; see DESIGN.md "Research agent") ---
# A run's first half, the Trend Search Agent, collects and scores what is
# trending; its second half checks the best topics in PubMed and Europe PMC.
# Proposes 4-6 topics per run; never generates on its own. Every value below
# has a working default — these are the ones to tune.
# RESEARCH_TARGET_ARTICLE_COUNT=5
# RESEARCH_MIN_ARTICLE_COUNT=4
# RESEARCH_MAX_ARTICLE_COUNT=6
# RESEARCH_MAX_CANDIDATES=50
# Trend sources (google_news is off by default: see the repo-root .env.example).
# RESEARCH_ENABLED_SOURCES=google_trends,rss,gdelt,news,web,youtube
# Requests per source per run, and the collect / enrich deadlines in seconds.
# RESEARCH_MAX_REQUESTS_PER_SOURCE=40
# RESEARCH_COLLECT_DEADLINE_SECONDS=300
# RESEARCH_ENRICH_DEADLINE_SECONDS=240
# Topics enriched with topic-specific searches, and handed to the evidence check.
# RESEARCH_ENRICH_POOL_SIZE=15
# RESEARCH_EVIDENCE_POOL_SIZE=8
# RESEARCH_TREND_WINDOW_DAYS=7
# RESEARCH_SCIENTIFIC_WINDOW_DAYS=365
# Trend score weights, integers summing to 100. A dimension with no data is left
# out and the rest renormalised, never guessed. No evidence in the score.
# RESEARCH_WEIGHT_MOMENTUM=30
# RESEARCH_WEIGHT_COVERAGE=25
# RESEARCH_WEIGHT_AUDIENCE=20
# RESEARCH_WEIGHT_FRESHNESS=15
# RESEARCH_WEIGHT_EDITORIAL_FIT=10
# Below this share of the score measured, a topic gets no score at all.
# RESEARCH_MIN_DATA_COVERAGE=0.6
# RESEARCH_MIN_TREND_SCORE=0
# RESEARCH_MIN_INDEPENDENT_SOURCES=2
# RESEARCH_MAX_PER_CATEGORY=2
# RESEARCH_REPEAT_COOLOFF_DAYS=28
# Trend history kept (observations per topic per run); validated at startup.
# RESEARCH_HISTORY_RETENTION_DAYS=180
# JSON file replacing the default RSS feeds (trends/feeds.py).
# RESEARCH_SOURCES_FILE=
# none | limited | emerging | moderate | strong — the evidence check's gate.
# RESEARCH_MIN_EVIDENCE_STATUS=emerging
# Candidates nobody promoted or dismissed are deleted this many days after
# their run; decided ones are kept (novelty reads them).
# RESEARCH_RETENTION_DAYS=60
# RESEARCH_GEO=US
# RESEARCH_LANGUAGE=en
# newsapi.org key (free developer plan: 100 requests/day, 24h delay, dev use
# only). Unset means keyless DuckDuckGo news instead.
# NEWS_API_KEY=
# false uses DuckDuckGo news even with a key set, without deleting it.
# NEWS_API_ENABLED=true
# Optional keyed sources; each is skipped (and says so) without its key.
# BRAVE_SEARCH_API_KEY=
# YOUTUBE_API_KEY=
# YOUTUBE_MAX_SEARCHES_PER_RUN=10
# Shared secret for n8n's /api/automation/* calls, 32+ characters. Unset
# disables those routes (404). See n8n/README.md.
# RESEARCH_TRIGGER_TOKEN=

# --- data retention ---
# MeSH ledger rows older than this are deleted after each succeeded scan. Must
# cover the baseline windows and the angle lookback (validated at startup).
# DISCOVERY_OBSERVATION_RETENTION_DAYS=120
