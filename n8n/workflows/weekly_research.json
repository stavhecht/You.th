{
  "name": "EvidWell - weekly research run",
  "nodes": [
    {
      "id": "schedule",
      "name": "Every week",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "={{ $env.RESEARCH_WEEKLY_CRON }}"
            }
          ]
        }
      }
    },
    {
      "id": "start-research-run",
      "name": "Start research run",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVIDWELL_API_URL }}/api/automation/research/runs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Trigger-Token",
              "value": "={{ $env.RESEARCH_TRIGGER_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, JSON.parse($env.RESEARCH_WEEKLY_PARAMS || '{}'), { mode: 'weekly' })) }}"
      }
    },
    {
      "id": "started",
      "name": "Started?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "accepted",
              "leftValue": "={{ $json.statusCode === 202 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "already-running",
      "name": "Already running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        160
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "conflict",
              "leftValue": "={{ $json.statusCode === 409 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "skip",
      "name": "Skipped: a run is already going",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        880,
        100
      ],
      "notes": "Runs are single-flight. A weekly slot that finds a manual run in progress lets it finish.",
      "parameters": {}
    },
    {
      "id": "start-failed",
      "name": "Could not start",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        880,
        260
      ],
      "parameters": {
        "errorMessage": "={{ 'The research run did not start: HTTP ' + $json.statusCode + ' ' + JSON.stringify($json.body) }}"
      }
    },
    {
      "id": "wait",
      "name": "Wait a minute",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        -120
      ],
      "webhookId": "6f1c2d3e-8a4b-4c5d-9e6f-7a8b9c0d1e2f",
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      }
    },
    {
      "id": "status",
      "name": "Read run status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -120
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.EVIDWELL_API_URL }}/api/automation/research/runs/{{ $('Start research run').item.json.body.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Trigger-Token",
              "value": "={{ $env.RESEARCH_TRIGGER_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "still-running",
      "name": "Still running?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        -120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "running",
              "leftValue": "={{ ['queued', 'running'].includes($json.status) && $runIndex < 45 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "result",
      "name": "Read trend result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -40
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.EVIDWELL_API_URL }}/api/automation/research/runs/{{ $('Start research run').item.json.body.id }}/result",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Trigger-Token",
              "value": "={{ $env.RESEARCH_TRIGGER_TOKEN }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          }
        }
      }
    },
    {
      "id": "run-failed",
      "name": "Failed before finding trends?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        -40
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "failed",
              "leftValue": "={{ $json.status === 'failed' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "run-failed-stop",
      "name": "Research run failed",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1760,
        60
      ],
      "parameters": {
        "errorMessage": "={{ 'Research run ' + $json.label + ' failed: ' + ($json.errors || []).join('; ') }}"
      }
    },
    {
      "id": "notify",
      "name": "Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1760,
        -140
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "has-url",
              "leftValue": "={{ Boolean($env.RESEARCH_NOTIFY_URL) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "send",
      "name": "Send summary",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -220
      ],
      "notes": "Slack-compatible: a 'text' line plus the topics. Points anywhere RESEARCH_NOTIFY_URL says.",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RESEARCH_NOTIFY_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'EvidWell research run ' + $json.label + ': ' + $json.status + ', ' + $json.topics.length + ' trending topic(s): ' + $json.topics.map(t => t.topic + ' (' + t.trend_score + ', ' + t.trend_status + ', ' + t.status + ')').join('; '), run_id: $json.run_id, status: $json.status, topics: $json.topics.map(t => ({ topic: t.topic, category: t.category, trend_score: t.trend_score, trend_status: t.trend_status, status: t.status, evidence_gate: t.downstream.evidence_gate, supporting_sources: t.supporting_sources.length })) }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "done",
      "name": "Research finished",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1980,
        -60
      ],
      "notes": "The trend result is $('Read trend result').item.json: topics with scores, sources and the evidence gate's status.",
      "parameters": {}
    }
  ],
  "connections": {
    "Every week": {
      "main": [
        [
          {
            "node": "Start research run",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start research run": {
      "main": [
        [
          {
            "node": "Started?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Started?": {
      "main": [
        [
          {
            "node": "Wait a minute",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Already running?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Already running?": {
      "main": [
        [
          {
            "node": "Skipped: a run is already going",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Could not start",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait a minute": {
      "main": [
        [
          {
            "node": "Read run status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read run status": {
      "main": [
        [
          {
            "node": "Still running?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Still running?": {
      "main": [
        [
          {
            "node": "Wait a minute",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Read trend result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read trend result": {
      "main": [
        [
          {
            "node": "Failed before finding trends?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Failed before finding trends?": {
      "main": [
        [
          {
            "node": "Research run failed",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Notify?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify?": {
      "main": [
        [
          {
            "node": "Send summary",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Research finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send summary": {
      "main": [
        [
          {
            "node": "Research finished",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "id": "EvidWellWeeklyRun"
}
